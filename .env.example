# Copy to .env and fill in. .env is gitignored.

# AWS Bedrock bearer token (Bedrock API key), NOT a SigV4 access-key pair.
# Kams exports this as AWS_BEARER_TOKEN_BEDROCK for boto3.
AMAZON_BEDROCK_API_KEY=

# Bedrock region. Model access is per-region — verify with scripts/probe_models.py.
AWS_REGION=us-east-1

# Model that drives the demo agent. Verified available: claude-sonnet-4-6.
KAMS_MODEL=us.anthropic.claude-sonnet-4-6

# Where the shim ships telemetry. Foundry puts the SigNoz ingester here.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# SigNoz API key, for provisioning dashboards/alerts as code.
# Generate at http://localhost:8080 -> Settings -> API Keys.
SIGNOZ_API_KEY=
SIGNOZ_URL=http://localhost:8080
