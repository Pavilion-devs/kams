{
  "title": "Kams — MCP Observability & Control",
  "description": "Traffic, reliability, integrity, and enforcement across every MCP server behind Kams. Provisioned as code from provisioning/dashboards/kams-mcp.json — never hand-clicked.",
  "tags": ["kams", "mcp", "agent-observability"],
  "version": "v5",
  "layout": [
    { "i": "traffic", "x": 0, "y": 0, "w": 6, "h": 6 },
    { "i": "latency", "x": 6, "y": 0, "w": 6, "h": 6 },
    { "i": "errors", "x": 0, "y": 6, "w": 6, "h": 6 },
    { "i": "integrity", "x": 6, "y": 6, "w": 6, "h": 6 },
    { "i": "cost", "x": 0, "y": 12, "w": 6, "h": 6 },
    { "i": "egress", "x": 6, "y": 12, "w": 6, "h": 6 },
    { "i": "enforcement", "x": 0, "y": 18, "w": 6, "h": 6 },
    { "i": "findings", "x": 6, "y": 18, "w": 6, "h": 6 },
    { "i": "logs", "x": 0, "y": 24, "w": 12, "h": 6 }
  ],
  "widgets": [
    {
      "id": "traffic",
      "title": "MCP call rate by server",
      "description": "Which third-party servers this agent fleet actually depends on.",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryFormulas": [],
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "expression": "A",
              "stepInterval": 60,
              "disabled": false,
              "aggregations": [
                {
                  "metricName": "mcp.tool.call.count",
                  "timeAggregation": "rate",
                  "spaceAggregation": "sum"
                }
              ],
              "filter": { "expression": "" },
              "groupBy": [{ "key": "server", "dataType": "string", "type": "tag" }],
              "legend": "{{server}}",
              "limit": 100,
              "having": [],
              "orderBy": [{ "columnName": "__result", "order": "desc" }]
            }
          ]
        }
      }
    },
    {
      "id": "latency",
      "title": "p95 MCP operation duration by server",
      "description": "A slow MCP server is a slow agent. Attributes the latency to the dependency responsible.",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryFormulas": [],
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "expression": "A",
              "stepInterval": 60,
              "disabled": false,
              "aggregations": [
                {
                  "metricName": "mcp.client.operation.duration.bucket",
                  "timeAggregation": "",
                  "spaceAggregation": "p95"
                }
              ],
              "filter": { "expression": "" },
              "groupBy": [{ "key": "server", "dataType": "string", "type": "tag" }],
              "legend": "{{server}}",
              "limit": 100,
              "having": [],
              "orderBy": [{ "columnName": "__result", "order": "desc" }]
            }
          ]
        }
      }
    },
    {
      "id": "errors",
      "title": "MCP errors by server and tool",
      "description": "Reliability of code you did not write and cannot patch.",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryFormulas": [],
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "expression": "A",
              "stepInterval": 60,
              "disabled": false,
              "aggregations": [
                {
                  "metricName": "mcp.tool.error.count",
                  "timeAggregation": "rate",
                  "spaceAggregation": "sum"
                }
              ],
              "filter": { "expression": "" },
              "groupBy": [
                { "key": "server", "dataType": "string", "type": "tag" },
                { "key": "tool", "dataType": "string", "type": "tag" }
              ],
              "legend": "{{server}} · {{tool}}",
              "limit": 100,
              "having": [],
              "orderBy": [{ "columnName": "__result", "order": "desc" }]
            }
          ]
        }
      }
    },
    {
      "id": "integrity",
      "title": "Integrity findings by severity",
      "description": "Tool-definition drift and injection detections. CRITICAL means a pinned definition changed into something that reads as prompt injection.",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryFormulas": [],
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "expression": "A",
              "stepInterval": 60,
              "disabled": false,
              "aggregations": [
                {
                  "metricName": "mcp.integrity.drift.count",
                  "timeAggregation": "increase",
                  "spaceAggregation": "sum"
                }
              ],
              "filter": { "expression": "" },
              "groupBy": [
                { "key": "severity", "dataType": "string", "type": "tag" },
                { "key": "server", "dataType": "string", "type": "tag" }
              ],
              "legend": "{{severity}} · {{server}}",
              "limit": 100,
              "having": [],
              "orderBy": [{ "columnName": "__result", "order": "desc" }]
            }
          ]
        }
      }
    },
    {
      "id": "enforcement",
      "title": "Control loop: enforcement by origin",
      "description": "What Kams did and whether the reflex detector or a SigNoz alert installed the restriction.",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryFormulas": [],
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "expression": "A",
              "stepInterval": 60,
              "disabled": false,
              "aggregations": [
                {
                  "metricName": "kams.enforcement.count",
                  "timeAggregation": "increase",
                  "spaceAggregation": "sum"
                }
              ],
              "filter": { "expression": "" },
              "groupBy": [
                { "key": "action", "dataType": "string", "type": "tag" },
                { "key": "rule", "dataType": "string", "type": "tag" },
                { "key": "origin", "dataType": "string", "type": "tag" }
              ],
              "legend": "{{origin}} · {{action}} · {{rule}}",
              "limit": 100,
              "having": [],
              "orderBy": [{ "columnName": "__result", "order": "desc" }]
            }
          ]
        }
      }
    },
    {
      "id": "findings",
      "title": "Detections by detector",
      "description": "Which detector is earning its keep. A detector that never fires and one that always fires are both problems.",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryFormulas": [],
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "expression": "A",
              "stepInterval": 60,
              "disabled": false,
              "aggregations": [
                {
                  "metricName": "kams.finding.count",
                  "timeAggregation": "increase",
                  "spaceAggregation": "sum"
                }
              ],
              "filter": { "expression": "" },
              "groupBy": [{ "key": "detector", "dataType": "string", "type": "tag" }],
              "legend": "{{detector}}",
              "limit": 100,
              "having": [],
              "orderBy": [{ "columnName": "__result", "order": "desc" }]
            }
          ]
        }
      }
    },
    {
      "id": "cost",
      "title": "MCP context cost by server",
      "description": "p95 model-context tokens caused by tool results. Estimated and Bedrock-reconciled values stay distinguishable.",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryFormulas": [],
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "expression": "A",
              "stepInterval": 60,
              "disabled": false,
              "aggregations": [
                {
                  "metricName": "mcp.context.cost.tokens.bucket",
                  "timeAggregation": "",
                  "spaceAggregation": "p95"
                }
              ],
              "filter": { "expression": "" },
              "groupBy": [
                { "key": "server", "dataType": "string", "type": "tag" },
                { "key": "estimated", "dataType": "string", "type": "tag" }
              ],
              "legend": "{{server}} · estimated={{estimated}}",
              "limit": 100,
              "having": [],
              "orderBy": [{ "columnName": "__result", "order": "desc" }]
            }
          ]
        }
      }
    },
    {
      "id": "egress",
      "title": "Sensitive egress by class",
      "description": "Credential and PII classes Kams saw crossing into MCP servers; values are never recorded.",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryFormulas": [],
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "expression": "A",
              "stepInterval": 60,
              "disabled": false,
              "aggregations": [
                {
                  "metricName": "mcp.egress.classified.count",
                  "timeAggregation": "increase",
                  "spaceAggregation": "sum"
                }
              ],
              "filter": { "expression": "" },
              "groupBy": [
                { "key": "server", "dataType": "string", "type": "tag" },
                { "key": "class", "dataType": "string", "type": "tag" }
              ],
              "legend": "{{server}} · {{class}}",
              "limit": 100,
              "having": [],
              "orderBy": [{ "columnName": "__result", "order": "desc" }]
            }
          ]
        }
      }
    },
    {
      "id": "logs",
      "title": "Kams finding and enforcement logs",
      "description": "Real OTLP logs correlated to the active trace and span, not console text copied into a dashboard.",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryFormulas": [],
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "logs",
              "expression": "A",
              "stepInterval": 60,
              "disabled": false,
              "aggregations": [{ "expression": "count()" }],
              "filter": {
                "expression": "service.name = 'kams-shim' OR service.name = 'kamsd'"
              },
              "groupBy": [
                { "key": "severity_text", "dataType": "string", "type": "tag" },
                { "key": "service.name", "dataType": "string", "type": "resource" }
              ],
              "legend": "{{service.name}} · {{severity_text}}",
              "limit": 100,
              "having": [],
              "orderBy": []
            }
          ]
        }
      }
    }
  ]
}
